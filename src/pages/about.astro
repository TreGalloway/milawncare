---
import Layout from '../layouts/Layout.astro';
import CTABanner from '../components/CTABanner.astro';

const ownerName = "Ronald K. Warren";
const companyName = "MI Premier Lawn Care, L.L.C";
const propertyCompany = "Delta Property Management, L.L.C";
const phoneNumber = "(810) 309-9528";
const yardbookUrl = "http://ydbk.co/137258";

const serviceAreas = ["Flint", "Flint Township", "Flushing", "Burton", "Grand Blanc"];
---

<Layout title="About Us">
  <section class="bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-white mb-4">
        About Us
      </h1>
      <p class="text-xl text-primary-100 max-w-2xl mx-auto">
        Learn more about our company and our mission
      </p>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-white to-transparent"></div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 lg:p-12">
        <div class="flex flex-col lg:flex-row gap-8 items-start">
          <div class="w-32 h-32 bg-primary-100 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-16 h-16 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-2">{ownerName}</h2>
            <p class="text-primary-600 font-semibold mb-4">Owner</p>
          </div>
        </div>

        <div class="mt-8 prose prose-lg max-w-none text-gray-600">
          <p>
            Hi, I'm {ownerName}. I created {companyName} in January 2026 to extend service that my property management company, namely {propertyCompany}, does not offer. Our emerging company specializes in residential lawns from one-eighth to one acre. We believe that our ability to grow relies on being trustworthy and decent, not treating customers purely as a means to our financial end. Our plan is to treat each customer as a one of one.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 lg:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
          <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-4">Service Area</h3>
          <p class="text-gray-600 mb-4">
            {companyName} serves the cities of:
          </p>
          <ul class="space-y-2">
            {serviceAreas.map((area) => (
              <li class="flex items-center gap-2 text-gray-700">
                <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {area}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
          <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-4">Our Services</h3>
          <p class="text-gray-600 mb-4">
            Our services include, but are not limited to:
          </p>
          <ul class="space-y-2">
            <li class="flex items-center gap-2 text-gray-700">
              <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Mowing
            </li>
            <li class="flex items-center gap-2 text-gray-700">
              <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Edging
            </li>
            <li class="flex items-center gap-2 text-gray-700">
              <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Blowing
            </li>
            <li class="flex items-center gap-2 text-gray-700">
              <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Fertilization
            </li>
            <li class="flex items-center gap-2 text-gray-700">
              <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Leaf Removal
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 lg:p-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">How It Works</h2>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div class="text-center">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-primary-600">1</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Free Consultation</h3>
            <p class="text-gray-600">
              The first step is our consultation. Before customers select a service agreement, we schedule their free consultation. We sit down with them and discuss their budget and lawn needs.
            </p>
          </div>
          
          <div class="text-center">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-primary-600">2</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Choose Your Plan</h3>
            <p class="text-gray-600">
              The second step is to decide which plan can fit within your budget and help maintain a beautiful and healthy lawn. We offer weekly and bi-weekly service agreements.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 lg:py-16 bg-primary-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Why Choose Us?</h2>
      <div class="grid md:grid-cols-3 gap-6 mt-8">
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="w-12 h-12 bg-accent-100 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Trustworthy</h3>
          <p class="text-gray-600 text-sm">We treat each customer as a one of one, not just a transaction.</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="w-12 h-12 bg-accent-100 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Best Rates</h3>
          <p class="text-gray-600 text-sm">We offer our lowest rates to service agreement customers.</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="w-12 h-12 bg-accent-100 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Local Business</h3>
          <p class="text-gray-600 text-sm">Proudly serving our local community since 2026.</p>
        </div>
      </div>
    </div>
  </section>

  <CTABanner 
    title="Ready to get started?"
    description="Click the link to schedule your FREE estimate today or call us at (810) 309-9528. We look forward to hearing from you!"
    buttonText="Schedule Free Estimate"
    buttonLink={yardbookUrl}
    phoneNumber={phoneNumber}
  />
</Layout>
