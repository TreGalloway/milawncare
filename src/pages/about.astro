---
import Layout from '../layouts/Layout.astro';
import BlocksRenderer from '../components/BlocksRenderer.astro';
import { fetchPage, fetchServices, fetchServiceAreas } from '../lib/strapi';

const services = await fetchServices();
const serviceAreas = await fetchServiceAreas();
const page = await fetchPage('about');

const pageTitle = page?.metaTitle || 'About Us';
const pageDescription = page?.metaDescription || 'Learn more about MI Premier Lawn Care and our mission';
---

<Layout title={pageTitle} description={pageDescription}>
  <BlocksRenderer 
    blocks={page?.blocks} 
    services={services}
    serviceAreas={serviceAreas}
  />
</Layout>
