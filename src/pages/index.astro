---
import Layout from '../layouts/Layout.astro';
import { fetchPages } from '../lib/strapi';

// Fetch all published pages for the navigation
const pages = await fetchPages();
---

<Layout title="Welcome to Milawn">
  <section class="bg-gradient-to-b from-primary-50 to-white py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6">
        Welcome to <span class="text-primary-600">Milawn</span>
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-10">
        A modern website built with Astro, Strapi, and Tailwind CSS. 
        Content is managed through Strapi's powerful Blocks editor.
      </p>
      <div class="flex justify-center gap-4">
        <a 
          href="/about" 
          class="bg-primary-600 text-white px-8 py-3 rounded-lg font-medium hover:bg-primary-700 transition"
        >
          Get Started
        </a>
        <a 
          href="https://strapi.io" 
          target="_blank"
          class="bg-white text-gray-700 border border-gray-300 px-8 py-3 rounded-lg font-medium hover:bg-gray-50 transition"
        >
          Learn About Strapi
        </a>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center mb-12">Pages</h2>
      
      {pages.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {pages.map((page) => (
            <a 
              href={`/${page.slug}`}
              class="group block bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-200 overflow-hidden"
            >
              <div class="p-6">
                <h3 class="text-xl font-semibold text-gray-900 group-hover:text-primary-600 transition mb-2">
                  {page.title}
                </h3>
                <p class="text-gray-600 text-sm">
                  {page.content?.[0]?.children?.[0]?.text?.substring(0, 100) || 'No description available'}...
                </p>
                <div class="mt-4 flex items-center text-primary-600 text-sm font-medium">
                  Read more
                  <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-gray-600 mb-4">No pages found in Strapi.</p>
          <p class="text-gray-500 text-sm">
            Make sure you've created pages in Strapi and the API is running on localhost:1337
          </p>
        </div>
      )}
    </div>
  </section>

  <section class="bg-gray-50 py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div class="bg-white p-8 rounded-xl shadow-sm">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Lightning Fast</h3>
          <p class="text-gray-600">Static site generation for optimal performance</p>
        </div>
        
        <div class="bg-white p-8 rounded-xl shadow-sm">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Easy Content Management</h3>
          <p class="text-gray-600">Powered by Strapi's intuitive Blocks editor</p>
        </div>
        
        <div class="bg-white p-8 rounded-xl shadow-sm">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Beautiful Design</h3>
          <p class="text-gray-600">Styled with Tailwind CSS</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
