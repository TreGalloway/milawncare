---
import Layout from '../layouts/Layout.astro';

const galleryImages = [
  { id: 1, title: 'Lawn Maintenance', description: 'Professional lawn care service' },
  { id: 2, title: 'Leaf Removal', description: 'Fall cleanup service' },
  { id: 3, title: 'Spring Cleanup', description: 'Seasonal preparation' },
  { id: 4, title: 'Mulch Installation', description: 'Fresh mulch installation' },
  { id: 5, title: 'Hedge Trimming', description: 'Professional shaping' },
  { id: 6, title: 'Fertilization', description: 'Green, healthy lawn' },
  { id: 7, title: 'Overseeding', description: 'Thicker, fuller grass' },
  { id: 8, title: 'Commercial Property', description: 'Professional maintenance' },
];
---

<Layout title="Gallery">
  <section class="bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-white mb-4">
        Our Work
      </h1>
      <p class="text-xl text-primary-100 max-w-2xl mx-auto">
        See the results of our professional lawn care services
      </p>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-white to-transparent"></div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map((image) => (
          <a 
            href={`#gallery-${image.id}`}
            class="group relative aspect-square rounded-2xl overflow-hidden bg-gray-100"
          >
            <div class="absolute inset-0 bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center">
              <div class="text-center p-6">
                <svg class="w-16 h-16 text-white/50 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="text-white/70 text-sm">[Upload from Strapi]</span>
              </div>
            </div>
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-end">
              <div class="p-6">
                <h3 class="text-white font-semibold text-lg">{image.title}</h3>
                <p class="text-white/80 text-sm">{image.description}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
      
      <div class="mt-12 text-center">
        <p class="text-gray-500">
          More photos coming soon! Contact us to see examples of our work.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Want to see more of our work?</h2>
      <p class="text-gray-600 mb-6">
        Contact us to see examples of our services in your area.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="http://ydbk.co/137258"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors"
        >
          Get a Free Quote
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 px-6 py-3 rounded-lg font-semibold transition-colors"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>
