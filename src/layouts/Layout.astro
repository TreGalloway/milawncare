---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Milawn - A modern website' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    html {
      font-family: 'Inter', system-ui, sans-serif;
    }
    
    body {
      @apply bg-white text-gray-900 antialiased;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">
  <header class="border-b border-gray-200 bg-white">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <a href="/" class="text-xl font-bold text-primary-600 hover:text-primary-700">
          Milawn
        </a>
        <div class="flex space-x-8">
          <a href="/" class="text-gray-600 hover:text-gray-900 transition">Home</a>
          <a href="/about" class="text-gray-600 hover:text-gray-900 transition">About</a>
        </div>
      </div>
    </nav>
  </header>
  
  <main class="flex-grow">
    <slot />
  </main>
  
  <footer class="bg-gray-50 border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <p class="text-center text-gray-600">
        © {new Date().getFullYear()} Milawn. Built with Astro & Strapi.
      </p>
    </div>
  </footer>
</body>
</html>
