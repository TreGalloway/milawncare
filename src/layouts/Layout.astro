---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { fetchSiteSettings } from '../lib/strapi';

interface Props {
  title: string;
  description?: string;
}

const DEFAULT_SITE_DATA = {
  companyName: 'MI Premier Lawn Care, L.L.C',
  phoneNumber: '(810) 309-9528',
  yardbookUrl: 'http://ydbk.co/137258',
  email: '',
  address: '',
  quoteButtonText: 'Get Quote',
  footerTagline: 'Professional lawn care services in Flint, MI and surrounding areas. Free estimates on all services. Quality you can trust.',
  facebookUrl: '',
};

const { title, description = 'MI Premier Lawn Care - Professional lawn care services in Flint, MI and surrounding areas. Free estimates on all services.' } = Astro.props;

let siteData = DEFAULT_SITE_DATA;
try {
  const settings = await fetchSiteSettings();
  if (settings) {
    siteData = {
      companyName: settings.companyName || DEFAULT_SITE_DATA.companyName,
      phoneNumber: settings.phoneNumber || DEFAULT_SITE_DATA.phoneNumber,
      yardbookUrl: settings.yardbookUrl || DEFAULT_SITE_DATA.yardbookUrl,
      email: settings.email || '',
      address: settings.address || '',
      quoteButtonText: settings.quoteButtonText || DEFAULT_SITE_DATA.quoteButtonText,
      footerTagline: settings.footerTagline || DEFAULT_SITE_DATA.footerTagline,
      facebookUrl: settings.facebookUrl || '',
    };
  }
} catch (e) {
  console.warn('Failed to fetch site settings, using defaults');
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} | {siteData.companyName}</title>
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    html {
      font-family: 'Inter', system-ui, sans-serif;
      scroll-behavior: smooth;
    }
    
    body {
      @apply bg-white text-gray-900 antialiased;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">
  <Header siteData={siteData} />
  
  <main class="flex-grow">
    <slot />
  </main>
  
  <Footer siteData={siteData} />
</body>
</html>
