events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript;

    server {
        listen ${NGINX_PORT};
        server_name mipremierlawncare.com www.mipremierlawncare.com localhost;
        root /app/dist;
        index index.html;

        # Astro static files
        location / {
            try_files $uri $uri/ /index.html;
            expires 1d;
            add_header Cache-Control "public, immutable";
        }

        # Health check endpoint — answered by nginx directly so Railway
        # health checks pass immediately on container start, before Strapi
        # and Astro finish initializing.
        location = /api/health {
            return 200 "OK";
            add_header Content-Type text/plain;
        }

        # Strapi API
        location /api/ {
            proxy_pass http://localhost:1337;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Server $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
        }

        # Block the public forgot-password endpoint — anyone on the internet
        # could spam this to flood admin inboxes or probe for valid accounts.
        # Password resets must be done by an existing admin from the dashboard,
        # or via: strapi admin:reset-user-password --email=you@example.com
        location = /admin/forgot-password {
            return 403;
        }

        # Strapi Admin
        # Cache-Control: no-store on the proxy response prevents the browser from
        # caching the admin HTML across deploys. Without this, browsers cache the
        # old HTML (with old content-hash chunk filenames) and fail to load the
        # new chunks after a redeploy, producing "error loading dynamically
        # imported module" crashes.
        location /admin {
            proxy_pass http://localhost:1337/admin;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Server $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
            proxy_hide_header Cache-Control;
            add_header Cache-Control "no-store";
        }

        # Strapi plugin API routes (not under /admin/)
        location /content-manager/ {
            proxy_pass http://localhost:1337/content-manager/;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Server $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
        }

        location /content-type-builder/ {
            proxy_pass http://localhost:1337/content-type-builder/;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Server $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
        }

        location /upload {
            proxy_pass http://localhost:1337;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Server $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            client_max_body_size 50m;
        }

        location /users-permissions/ {
            proxy_pass http://localhost:1337/users-permissions/;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Server $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
        }

        location /i18n/ {
            proxy_pass http://localhost:1337/i18n/;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Server $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
        }

        # Strapi Uploads (if using local storage temporarily)
        location /uploads/ {
            proxy_pass http://localhost:1337/uploads/;
        }
    }
}
